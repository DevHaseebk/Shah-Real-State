# Copy to .env.local for development; set the same variables in Vercel for production.

# The API (backend). Server side: content and listings. Leave empty to use src/content/site.ts with no listings.
API_URL=http://localhost:4000
# The same API URL, for the browser (view and enquiry counts on property pages).
NEXT_PUBLIC_API_URL=http://localhost:4000

# This website's public address, for links in WhatsApp messages, canonical URLs and sharing previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must match REVALIDATE_SECRET in the backend, so admin changes show on the next visit.
REVALIDATE_SECRET=change-me-too
